{
  "expo": {
    "name": "Simple Talk",
    "slug": "simple-talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "simpletalk",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simple_talk.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip", "remote-notification"],
        "NSCameraUsageDescription": "Simple Talk needs camera access for video calls.",
        "NSMicrophoneUsageDescription": "Simple Talk needs microphone access for audio and video calls.",
        "NSUserNotificationsUsageDescription": "Simple Talk sends call and account notifications."
      }
    },
    "android": {
      "package": "com.simple_talk.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F1A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "WAKE_LOCK",
        "VIBRATE",
        "READ_PHONE_STATE",
        "CALL_PHONE",
        "BIND_TELECOM_CONNECTION_SERVICE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Simple Talk to access your microphone for calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Simple Talk to access your camera for video calls."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
