BACKEND_URL=http://localhost:8000
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/voxora?retryWrites=true&w=majority
MONGODB_DB=voxora

# Upstash: REST pair OR redis TLS URL (code supports both)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:TOKEN@xxxxx.upstash.io:6379

JWT_SECRET=change-me-long-random
JWT_EXPIRE_DAYS=30
ADMIN_JWT_SECRET=change-me-admin-long-random
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
SOCKETIO_CORS_ORIGINS=*

ENVIRONMENT=development
ALLOW_ADMIN_BOOTSTRAP=true

DEV_OTP_CODE=123456
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_API_KEY=
MESSAGECENTRAL_EMAIL=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

TRUSTOPE_USER_TOKEN=
TRUSTOPE_REDIRECT_URL=http://localhost:8000/api/wallet/recharge/return

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

COMMISSION_RATE=0.15
CALL_RING_TIMEOUT_SECONDS=45
MIN_AUDIO_RATE=3.0
MIN_VIDEO_RATE=7.0
APP_MIN_VERSION_ANDROID=1.0.0
APP_MIN_VERSION_IOS=1.0.0
DEEP_LINK_SCHEME=voxora
