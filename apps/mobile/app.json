{
  "expo": {
    "name": "Simple Talk",
    "slug": "simple-talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "simpletalk",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simpletalk.app",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Simple Talk needs camera access for video calls.",
        "NSMicrophoneUsageDescription": "Simple Talk needs microphone access for audio and video calls.",
        "NSUserNotificationsUsageDescription": "Simple Talk sends call and account notifications."
      }
    },
    "android": {
      "package": "com.simple_talk.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F1A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.CALL_PHONE",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.INTERNET"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withAndroidDuplicateLibsFix.js",
      "./plugins/withAndroidNotificationIcon.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Simple Talk to access your microphone for calls."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Simple Talk to access your camera for video calls."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F1A",
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "17db387a-54a3-4068-9c79-e3a4e1d84454"
      },
      "router": {}
    },
    "owner": "vik_07"
  }
}
