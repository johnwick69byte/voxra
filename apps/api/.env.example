# Production: https://voxra-dkfe.onrender.com
BACKEND_URL=https://voxra-dkfe.onrender.com
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/voxora?retryWrites=true&w=majority
MONGODB_DB=voxora

# Upstash: REST pair OR redis TLS URL (code supports both)
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=rediss://default:TOKEN@xxxxx.upstash.io:6379

# Keep JWT_SECRET stable after launch; rotating it logs every user out.
JWT_SECRET=change-me-long-random
JWT_EXPIRE_DAYS=45
ADMIN_JWT_SECRET=change-me-admin-long-random
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
SOCKETIO_CORS_ORIGINS=*

ENVIRONMENT=development
ALLOW_ADMIN_BOOTSTRAP=true

# Dev OTP is hardcoded to 7723 in auth_service.py (accepted in all environments)
# DEV_OTP_CODE is not read by the server.
MESSAGECENTRAL_CUSTOMER_ID=
# Either: dashboard login password (we Base64-encode it) OR a JWT authToken (starts with eyJ).
# Do NOT pass the JWT as the token-API `key` — that key must be Base64(password).
MESSAGECENTRAL_API_KEY=
MESSAGECENTRAL_EMAIL=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Firebase FCM: Option A = path to the Admin SDK JSON (on Render use a Secret
# File mount). Option B = paste the whole JSON into FIREBASE_CREDENTIALS_JSON.
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

COMMISSION_RATE=0.15
WITHDRAWAL_COMMISSION_RATE=0.10
MODEL_REFERRAL_BONUS_PERCENTAGE=5
MODEL_REFERRAL_MIN_WITHDRAWAL=100
REFERRAL_BONUS_REFERRER=25
REFERRAL_BONUS_REFEREE=20
CALL_RING_TIMEOUT_SECONDS=45
MIN_AUDIO_RATE=3.0
MIN_VIDEO_RATE=7.0
APP_MIN_VERSION_ANDROID=1.0.0
APP_MIN_VERSION_IOS=1.0.0
DEEP_LINK_SCHEME=simpletalk

# ── PayQ payments (recharge, live only) ──────────────
# PAYQ_USER_TOKEN is the merchant API token from the PayQ dashboard.
# PAYQ_WEBHOOK_SECRET is the *separate* Webhook Secret from API Setup.
# Rotate the token if it was ever pasted into a document or chat.
PAYQ_BASE_URL=https://payq.cc/api
PAYQ_USER_TOKEN=
PAYQ_WEBHOOK_SECRET=
# Optional override; default is BACKEND_URL + /api/wallet/recharge/return
PAYQ_RETURN_URL=

# Recharge limits and economics: 6% total fee, user credited 94%.
# PayQ's gateway commission is 0%, so by default all 6% is platform service.
MIN_RECHARGE_AMOUNT=50
MAX_RECHARGE_AMOUNT=100000
RECHARGE_COMMISSION_RATE=0.06
# Gateway share of that total; service commission is the remainder (6% - this).
RECHARGE_GATEWAY_RATE=0.0
